{% extends 'base.html.twig' %}

{% block title %}Welcome{% endblock %}

{% block body %}
    <div class="container mt-5 text-center">
        <h1 class="mb-4">Welcome to Our Platform</h1>
        <div class="d-flex justify-content-center gap-3">
            <a href="{{ path('app_register', {type: 'customer'}) }}" class="btn btn-success btn-lg">Register as Customer</a>
            <a href="{{ path('app_register', {type: 'admin'}) }}" class="btn btn-warning btn-lg">Register as Admin</a>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg">Login</a>
        </div>
    </div>
{% endblock %}
