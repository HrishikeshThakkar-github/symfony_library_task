<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Verify Your Email</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f4f8;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            background: white;
            padding: 60px;
            border-radius: 10px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 480px;
            width: 100%;
        }

        h1 {
            margin-bottom: 20px;
            color: #2c3e50;
        }

        p {
            color: #555;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        .btn {
            background-color: #4285F4; /* Google Blue */
            color: #fff;
            padding: 14px 28px;
            font-size: 1rem;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: #3367d6;
        }

        .info {
            margin-top: 20px;
            font-size: 0.85rem;
            color: #888;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Check Your Inbox</h1>
    <p>
        We've sent a verification email to <strong>{{ user.email }}</strong>.<br>
        Click the button below to open Gmail and verify your account.
    </p>
    <a href="https://mail.google.com" target="_blank" class="btn">Open Gmail</a>
    <div class="info">
        Didn’t receive the email? Please check your spam folder or wait a few minutes.
    </div>
</div>
</body>
</html>
