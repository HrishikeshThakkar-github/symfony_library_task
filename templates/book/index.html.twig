{% extends 'base.html.twig' %}

{% block title %}Book Management{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4 text-primary">Library Book List</h1>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_book_new') }}" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Create New Book
            </a>
        </div>

        <br>

        <table id="bookTable" class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.id }}</td>
                    <td>{{ book.title }}</td>
                    <td>{{ book.author }}</td>
                    <td>
                        {% if book.isAvailable %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-info btn-sm me-1">
                            <i class="bi bi-eye"></i> Show
                        </a>
                        <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>


    </div>
{% endblock %}
