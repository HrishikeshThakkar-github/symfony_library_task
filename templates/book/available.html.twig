{% extends 'base.html.twig' %}

{% block title %}Available Books{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="text-center mb-4">Available Books</h2>

        <table id="availableBooksTable" class="table table-striped table-bordered shadow-sm">
            <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.title }}</td>
                    <td>{{ book.author }}</td>
                    <td>
                        <a href="{{ path('borrow_book', {id: book.id}) }}" class="btn btn-primary btn-sm">Borrow</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">No books are currently available.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="mt-4 text-center">
            <a href="{{ path('app_customer_loan') }}" class="btn btn-success btn-lg">See Borrowed Books</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('#availableBooksTable').DataTable({
                responsive: true,
                paging: true,
                ordering: true,
                info: true,
                language: {
                    search: "Search Books:"
                }
            });
        });
    </script>
{% endblock %}
