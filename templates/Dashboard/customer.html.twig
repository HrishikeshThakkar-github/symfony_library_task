{% extends 'base.html.twig' %}

{% block title %}Customer Dashboard{% endblock %}

{% block body %}
    <div class="alert alert-info" role="alert">
        {% if app.user %}
            <h1>Welcome, {{ app.user.email }}</h1>
        {% else %}
            <h1>Welcome, Guest</h1>
        {% endif %}

        <p>You have successfully registered as a customer. This is your dashboard.</p>
        <a href="{{ path('app_logout') }}" class="btn btn-success btn-lg">Logout</a>

    </div>
{% endblock %}
