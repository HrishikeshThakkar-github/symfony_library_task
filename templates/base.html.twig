<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Library{% endblock %}</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <style>
            body {
                background-color: #f0f2f5; /* Soft gray background */
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .navbar {
                background-color: #f8f9fa !important; /* Light gray navbar */
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                padding: 1.2rem 2rem; /* Taller navbar */
            }

            .navbar-brand {
                font-size: 1.75rem;
                font-weight: 700;
                color: #343a40 !important;
            }

            .navbar-nav .nav-link {
                font-size: 1.2rem;
                margin-right: 1.2rem;
                color: #495057 !important;
                transition: color 0.2s ease-in-out;
            }

            .navbar-nav .nav-link:hover {
                color: #669fed !important; /* Bootstrap primary blue on hover */
            }

            .btn {
                font-size: 1.1rem;
                padding: 0.6rem 1.4rem;
                border-radius: 0.4rem;
            }

            .btn-success {
                background-color: #88eaa2;
                border-color: #88eaa2;
            }

            .btn-warning {
                background-color: #e4c56d;
                border-color: #e4c56d;
                color: #212529;
            }

            .btn-outline-primary {
                color: #669fed;
                border-color: #669fed;
            }

            .btn-outline-primary:hover {
                background-color: #0067fb;
                color: white;
            }
        </style>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#table').DataTable({
                    responsive: true
                });
            });
        </script>
    </head>
    <body style="background-color: #d8d8d8;">

    <nav class="navbar navbar-expand-lg"style="background-color: #ffffff;">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_homepage') }}">📚 Library</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarMain">
                <ul class="navbar-nav align-items-center gap-2">

                    {% if app.user %}
                        {% if is_granted('ROLE_CUSTOMER') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_customer_loan') }}">My Loans</a>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_book_index') }}">Manage Books</a>
                            </li>
                        {% endif %}

                        <li class="nav-item">
                            <span class="nav-link text-muted">Hi, {{ app.user.email }}</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-danger" href="{{ path('app_logout') }}">Logout</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="btn btn-success" href="{{ path('app_register', {type: 'customer'}) }}">Register as Customer</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-info text-white" href="{{ path('app_register', {type: 'admin'}) }}">Register as Admin</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary" href="{{ path('app_login') }}">Login</a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_logout') }}" class="btn btn-danger ">Logout</a>
                        </li>

                    {% endif %}

                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-4" >
        {% block body %}{% endblock %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>

</html>
